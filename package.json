{
  "name": "opalesce",
  "version": "0.1.0",
  "private": true,
  "description": "Opalesce workspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json -f",
    "build:workspace": "nx run-many -t build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "check:workspace": "nx run-many -t check",
    "lint": "eslint .",
    "format": "eslint . --fix && oxfmt .",
    "format:check": "oxfmt --check .",
    "format.check": "pnpm run format:check",
    "generate": "nx run @opalesce/cli:build && opalesce generate",
    "release": "semantic-release",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:unit": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@asyncapi/parser": "^3.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "json-schema-to-zod": "^2.7.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nx/js": "23.1.0",
    "@opalesce/cli": "workspace:*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.1",
    "nx": "23.1.0",
    "oxfmt": "^0.54.0",
    "semantic-release": "25.0.3",
    "semantic-release-run-when": "1.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.0"
}
