{
  "name": "@opalesce/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Opalesce workspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run build:workspace",
    "build:workspace": "nx run-many -t build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check:workspace",
    "check:workspace": "nx run-many -t check --parallel=1",
    "lint": "eslint .",
    "format": "eslint . --fix && oxfmt .",
    "format:check": "oxfmt --check .",
    "format.check": "pnpm run format:check",
    "generate": "nx run opalesce:build && opalesce generate",
    "test": "nx run-many -t test --parallel=1",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nx/js": "23.1.0",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.1",
    "nx": "23.1.0",
    "opalesce": "workspace:*",
    "oxfmt": "^0.54.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.0"
}
