{
  "name": "@opalesce/core",
  "version": "0.0.1",
  "description": "Transform AsyncAPI specifications into artifacts with Opalesce's plugin-based generation engine.",
  "keywords": [
    "artifact-generator",
    "asyncapi",
    "asyncapi-generator",
    "code-generator",
    "codegen",
    "core-library",
    "event-driven-api",
    "event-driven-architecture",
    "opalesce",
    "plugin-framework",
    "plugin-system",
    "plugins",
    "schema-parser",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@asyncapi/parser": "^3.6.0"
  }
}
