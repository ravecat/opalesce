{
  "name": "opalesce",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer-facing package facade for Opalesce",
  "bin": {
    "opalesce": "./bin/opalesce.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@opalesce/cli": "workspace:*",
    "@opalesce/config": "workspace:*",
    "@opalesce/core": "workspace:*"
  }
}
