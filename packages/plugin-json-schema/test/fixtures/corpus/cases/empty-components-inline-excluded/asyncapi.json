{
  "asyncapi": "3.1.0",
  "info": { "title": "Inline payload only", "version": "1.0.0" },
  "channels": {
    "events": {
      "address": "events",
      "messages": {
        "Inline": { "payload": { "type": "object", "properties": { "id": { "type": "string" } } } }
