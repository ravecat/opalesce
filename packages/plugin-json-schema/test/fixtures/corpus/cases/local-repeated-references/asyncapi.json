{
  "asyncapi": "3.1.0",
  "info": { "title": "Repeated references", "version": "1.0.0" },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1 } }
      },
      "Envelope": {
