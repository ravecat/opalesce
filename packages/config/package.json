{
  "name": "@opalesce/config",
  "version": "0.0.1",
  "description": "Type-safe project configuration for generating artifacts from AsyncAPI specifications with Opalesce.",
  "keywords": [
    "artifact-generator",
    "asyncapi",
    "asyncapi-generator",
    "code-generator",
    "codegen",
    "configuration",
    "event-driven-api",
    "opalesce",
    "plugins",
    "type-safe",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@opalesce/core": "workspace:*"
  }
}
