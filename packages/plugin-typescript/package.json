{
  "name": "@opalesce/plugin-typescript",
  "version": "0.0.1",
  "description": "Generate deterministic TypeScript interaction contracts from AsyncAPI specifications.",
  "keywords": [
    "asyncapi",
    "codegen",
    "event-driven-api",
    "opalesce",
    "plugin",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git",
    "directory": "packages/plugin-typescript"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@opalesce/core": "workspace:*",
    "typescript": "^6.0.2"
  }
}
