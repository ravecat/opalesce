{
  "name": "@opalesce/cli",
  "version": "0.0.1",
  "description": "Generate code and other artifacts from AsyncAPI specifications through the Opalesce command-line interface.",
  "keywords": [
    "artifact-generator",
    "asyncapi",
    "asyncapi-generator",
    "cli",
    "code-generator",
    "codegen",
    "command-line",
    "command-line-tool",
    "event-driven-api",
    "opalesce",
    "plugin-system",
    "plugins",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravecat/opalesce.git",
    "directory": "packages/cli"
  },
  "bin": {
    "opalesce": "./bin/opalesce.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@opalesce/config": "workspace:*",
    "@opalesce/core": "workspace:*"
  }
}
